# https://resend.com/api-keys — never commit the real key
RESEND_API_KEY=

# Verified domain sender (production). Format: Name <noreply@your-verified-domain.com>
# Docs: https://resend.com/domains — do NOT use onboarding@resend.dev in production.
# Locally, if unset in development, code falls back to onboarding@resend.dev for sandbox tests only.
RESEND_FROM_EMAIL=

# Inbox(es) where quote requests arrive (comma not supported here; single address recommended)
QUOTE_TO_EMAIL=alfonsomobilegrooming@gmail.com
