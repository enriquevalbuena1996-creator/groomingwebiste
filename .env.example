# https://resend.com/api-keys — never commit the real key
RESEND_API_KEY=

# Verified sender in Resend — must be from a domain YOU verify (not @gmail / @yahoo / @hotmail).
# Format: Name <noreply@your-verified-domain.com> or bare noreply@yourdomain.com
# (Alias: FROM_EMAIL instead of RESEND_FROM_EMAIL — same.) Docs: https://resend.com/domains
RESEND_FROM_EMAIL=

# Inbox(es) where quote requests arrive (comma not supported here; single address recommended)
QUOTE_TO_EMAIL=alfonsomobilegrooming@gmail.com
